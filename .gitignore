# =============================================================================
# OTUA Protocol — .gitignore
# =============================================================================

# --- Node / pnpm ---
node_modules/
.pnpm-store/
.pnpm-debug.log

# --- Build artifacts ---
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# --- Coverage ---
coverage/
.nyc_output/

# --- Environment secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep .env.example — it is intentionally tracked.
!.env.example
apps/**/.env
apps/**/.env.local
!apps/**/.env.example

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Rust / Cargo ---
target/
Cargo.lock
# Note: contracts/group-buy-escrow/Cargo.lock is intentionally committed
# for reproducible contract builds (override below).
!contracts/**/Cargo.lock

# --- IDE / Editor ---
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# --- OS ---
.DS_Store
ehthumbs.db
desktop.ini

# --- Test / Vitest ---
*.snap
.vitest/

# --- Misc ---
*.local
.cache/
tmp/
temp/
