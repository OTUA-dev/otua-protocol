# =============================================================================
# OTUA Protocol — Environment Variable Reference
# =============================================================================
# Copy this file to .env (never commit .env).
# Variables marked SENSITIVE must never be committed or logged.
# Variables marked PUBLIC may be exposed to the browser (NEXT_PUBLIC_ prefix).
# Variables marked SERVER-ONLY must never be assigned a NEXT_PUBLIC_ prefix.
#
# Foundation phase: most variables are placeholders.
# Actual required variables will be documented as each module is implemented.
# =============================================================================

# -----------------------------------------------------------------------------
# Node environment
# Values: development | test | production
# Required: yes
# Sensitive: no
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# API — Base URL (used by the web app to reach the API)
# Required: yes (for web app)
# Sensitive: no
# PUBLIC: yes (used client-side)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# API — Server port
# Required: no (defaults to 3001)
# Sensitive: no
# SERVER-ONLY: yes
# -----------------------------------------------------------------------------
API_PORT=3001

# -----------------------------------------------------------------------------
# Stellar — Network passphrase
# Values: Test SDF Network ; September 2015  |  Public Global Stellar Network ; September 2015
# Required: yes (when Stellar integration is active — Phase 2+)
# Sensitive: no
# SERVER-ONLY: yes
# -----------------------------------------------------------------------------
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# -----------------------------------------------------------------------------
# Stellar — Horizon URL
# Required: yes (when Stellar integration is active — Phase 2+)
# Sensitive: no
# SERVER-ONLY: yes
# -----------------------------------------------------------------------------
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# -----------------------------------------------------------------------------
# Stellar — RPC URL (Soroban)
# Required: yes (when Soroban contract interaction is active — Phase 3+)
# Sensitive: no
# SERVER-ONLY: yes
# -----------------------------------------------------------------------------
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# -----------------------------------------------------------------------------
# Database — Connection URL
# Required: yes (when database is introduced — Phase 2+)
# SENSITIVE: yes — never log, never commit
# SERVER-ONLY: yes
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/otua_dev

# -----------------------------------------------------------------------------
# JWT / Auth secret
# Required: yes (when authentication is active — Phase 2+)
# SENSITIVE: yes — generate with: openssl rand -base64 64
# SERVER-ONLY: yes
# -----------------------------------------------------------------------------
# JWT_SECRET=replace-with-a-securely-generated-secret

# -----------------------------------------------------------------------------
# Indexer — Internal URL (used by API to query the indexer read model)
# Required: yes (when indexer is active — Phase 3+)
# Sensitive: no
# SERVER-ONLY: yes
# -----------------------------------------------------------------------------
# INDEXER_BASE_URL=http://localhost:3002
